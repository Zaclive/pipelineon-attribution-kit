KIT_SITE_ID=your-website
KIT_SITE_NAME=Your website
KIT_PUBLIC_URL=http://localhost:4310
KIT_ALLOWED_ORIGINS=https://example.com,https://www.example.com
KIT_DATABASE=data/attribution.sqlite
# Generate separate random tokens. Keep the write token on trusted servers only.
KIT_READ_TOKEN=
KIT_WRITE_TOKEN=
HOST=127.0.0.1
PORT=4310
# Optional Meta delivery. Start in test mode with an Events Manager test code.
KIT_META_MODE=disabled
KIT_META_DATASET_ID=
KIT_META_ACCESS_TOKEN=
KIT_META_TEST_EVENT_CODE=
# Optional Google Ads offline conversions via Data Manager API.
# Start with validate: validation does not send live conversions.
KIT_GOOGLE_MODE=disabled
KIT_GOOGLE_ACCOUNT_ID=
KIT_GOOGLE_LOGIN_ACCOUNT_ID=
KIT_GOOGLE_CONVERSION_ACTIONS={"lead_received":"123456789","payment_received":"987654321"}
KIT_GOOGLE_CLIENT_ID=
KIT_GOOGLE_CLIENT_SECRET=
KIT_GOOGLE_REFRESH_TOKEN=

# Optional verified CallRail receiver and API refresh worker. See CALLRAIL.md.
KIT_CALLRAIL_ACCOUNT_ID=
KIT_CALLRAIL_COMPANY_ID=
KIT_CALLRAIL_API_KEY=
KIT_CALLRAIL_SIGNING_KEY=
KIT_CALLRAIL_COOKIE_NAME=
# Leave blank unless configuring CallRail. Use external or self.
KIT_CALLRAIL_META_OWNER=
